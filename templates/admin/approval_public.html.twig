{% extends 'base.html.twig' %}

{% set show_sidebar = false %}

{% block title %}Approval{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 960px;">
    <h1 class="h3 mb-3">Invoice Approval</h1>

    {% if invoice %}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div><strong>Vendor:</strong> {{ invoice.vendor_name }}</div>
                <div><strong>Invoice #:</strong> {{ invoice.invoice_number }}</div>
                <div><strong>Amount:</strong> {{ invoice.amount }} {{ invoice.currency }}</div>
                <div><strong>Status:</strong> {{ request.status }}</div>
            </div>
        </div>
    {% endif %}

    <div class="mb-3">
        {% if pdf_url %}
            <iframe src="{{ pdf_url }}" style="width:100%; height:600px;"></iframe>
        {% else %}
            <p class="text-muted">No PDF available.</p>
        {% endif %}
    </div>

    <div class="d-flex gap-2">
        <form method="post" action="/approvals/{{ request.token }}/approve">
            <button class="btn btn-success" type="submit">Approve</button>
        </form>
        <form method="post" action="/approvals/{{ request.token }}/reject">
            <button class="btn btn-outline-danger" type="submit">Reject</button>
        </form>
    </div>
</div>
{% endblock %}
