{% extends 'base.html.twig' %}

{% block title %}Invoice{% endblock %}

{% block body %}
<h1 class="h3 mb-4">Invoice {{ invoice.invoice_number }}</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="mb-2"><strong>Vendor:</strong> {{ invoice.vendor_name }}</div>
                <div class="mb-2"><strong>Amount:</strong> {{ invoice.amount }} {{ invoice.currency }}</div>
                <div class="mb-2"><strong>Invoice date:</strong> {{ invoice.invoice_date }}</div>
                <div class="mb-2"><strong>Due date:</strong> {{ invoice.due_date }}</div>
                <div class="mb-2"><strong>Status:</strong> {{ invoice.approval_status }}</div>
                <div class="mb-2"><strong>Payment:</strong> {{ invoice.payment_status }}</div>
                <div class="mb-2"><strong>Project:</strong> {{ invoice.project_name }}</div>
                <div class="mb-2"><strong>Category:</strong> {{ invoice.expense_category }}</div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Approval history</div>
            <ul class="list-group list-group-flush">
                {% for approval in approvals %}
                    <li class="list-group-item">
                        {{ approval.status }} - {{ approval.approver_email }} ({{ approval.responded_at }})
                    </li>
                {% else %}
                    <li class="list-group-item text-muted">No approvals yet.</li>
                {% endfor %}
            </ul>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">Audit log</div>
            <ul class="list-group list-group-flush">
                {% for item in audit_logs %}
                    <li class="list-group-item">
                        {{ item.created_at }} - {{ item.action }}
                    </li>
                {% else %}
                    <li class="list-group-item text-muted">No audit entries.</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">Invoice PDF</div>
            <div class="card-body">
                {% if pdf_url %}
                    <iframe src="{{ pdf_url }}" style="width:100%; height:600px;"></iframe>
                {% else %}
                    <p class="text-muted">No PDF available.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
